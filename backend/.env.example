# Ollama
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=gemma4:e4b
LIGHT_MODEL=gemma4:e2b
DEEP_MODEL=qwen2.5-coder:7b

# Context window (tokens). Keep small for 6 GB VRAM.
NUM_CTX=4096

# GitHub (optional — increases rate limit and allows private repos)
GITHUB_TOKEN=

# Database
DB_PATH=vector.db

# Frontend dev origin for CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=

# Prompt version bump to invalidate cache
PROMPT_VERSION=1
