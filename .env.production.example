# Vector Production Environment Configuration
# Copy this file to .env before running `docker compose up -d`

# Port to expose on the host (default: 80)
PORT=80

# Ollama server URL
# When Ollama runs natively on the Linux/Windows/Mac host, use host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11434

# Models (must be pulled via `ollama pull <model>` on the host machine)
DEFAULT_MODEL=gemma4:e4b
LIGHT_MODEL=gemma4:e2b
DEEP_MODEL=qwen2.5-coder:7b

# Context window size in tokens (4096 is recommended for 6-8 GB VRAM)
NUM_CTX=4096

# GitHub personal access token (optional, raises rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Allowed CORS origins (optional, comma-separated; e.g. https://yourdomain.com)
CORS_ORIGINS=
